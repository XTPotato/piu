# Normalize to LF in the repository; Git checks out native line endings.
# This repo is developed on both Windows and Linux, so leaving it to chance
# produces spurious whole-file diffs when switching platforms.
* text=auto eol=lf

# Windows-only scripts must keep CRLF to run correctly.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never touch, never diff as text.
*.png binary
*.jpg binary
*.ogg binary
*.mp3 binary
*.wav binary
*.flac binary
*.ttf binary
*.otf binary
